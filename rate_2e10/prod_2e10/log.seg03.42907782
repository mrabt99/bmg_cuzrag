LAMMPS (23 Jun 2022)
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread. (src/src/comm.cpp:98)
  using 1 OpenMP thread(s) per MPI task
# =====================================================================
#  Produccion 2e10 K/s (tramo 3/16) : 1700 K -> 1600 K
#  Zr47.5 Cu47.5 Ag5 BMG - N65536 - Negishi/SLURM - v4 (NPT, Pdamp=10)
#
#  Continuacion de sweep_2e10 (el unico de los 7 tramos de prueba que
#  sobrevivio entero, 2000->1900K en 5 ns sin disparar fix halt). Se
#  sigue enfriando a la MISMA tasa constante (2e10 K/s) hasta 300 K,
#  con la misma fisica que el resto del proyecto (potencial EAM
#  original sin tocar, NPT Pdamp=10.0/Tdamp=0.1, dt=1fs fijo).
#
#  Aritmetica: 100 K / 2e10 K/s = 5e-9 s = 5 ns = 5000000 pasos por
#  tramo de 100 K (mismo numero que en sweep_2e10). Quedan 16 tramos
#  de 1900 a 300 K.
#
#  Entrada:  restart.quench_${tag}_${rate}.seg2
#  Salida:   restart.quench_${tag}_${rate}.seg3
#            quench_${tag}_${rate}.dump.seg3    (10 frames, cada 10K = cada 5e5 pasos)
#            quench_${tag}_${rate}.log.dat.seg3 (T, Ep/atomo, Lx, rho, P)
# =====================================================================

variable        tag   index N65536
variable        pot   index ../ZrCuAg.lammps.eam
variable        rate  index 2e10
variable        pdamp index 10.0

read_restart    restart.quench_${tag}_${rate}.seg2
read_restart    restart.quench_N65536_${rate}.seg2
read_restart    restart.quench_N65536_2e10.seg2
Reading restart file ...
  restart file = 23 Jun 2022, LAMMPS = 23 Jun 2022
  restoring atom style atomic from restart
  orthogonal box = (3.762412 3.762412 3.762412) to (111.31864 111.31864 111.31864)
  3 by 4 by 4 MPI processor grid
  pair style eam/alloy stores no restart info
  65536 atoms
  read_restart CPU = 0.018 seconds

pair_style      eam/alloy
pair_coeff      * * ${pot} Zr Cu Ag
pair_coeff      * * ../ZrCuAg.lammps.eam Zr Cu Ag

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

timestep        0.001                       # 1 fs -- fijo, no tocar (VDOS/fonones)

thermo          5000
thermo_style    custom step temp press vol density pe etotal

variable        Tinst equal temp
variable        Pinst equal press
variable        PEat  equal pe/atoms
variable        Lbox  equal lx
variable        Rho   equal density

fix             log2 all ave/time 50 100 5000                 v_Tinst v_PEat v_Lbox v_Rho v_Pinst                 file quench_${tag}_${rate}.log.dat.seg3                 title2 "# T(K)  Ep(eV/at)  Lx(A)  rho(g/cc)  P(bar)"
fix             log2 all ave/time 50 100 5000                 v_Tinst v_PEat v_Lbox v_Rho v_Pinst                 file quench_N65536_${rate}.log.dat.seg3                 title2 "# T(K)  Ep(eV/at)  Lx(A)  rho(g/cc)  P(bar)"
fix             log2 all ave/time 50 100 5000                 v_Tinst v_PEat v_Lbox v_Rho v_Pinst                 file quench_N65536_2e10.log.dat.seg3                 title2 "# T(K)  Ep(eV/at)  Lx(A)  rho(g/cc)  P(bar)"

fix             halt_T all halt 1000 v_Tinst > 8000.0 error hard
fix             halt_P all halt 1000 v_Pinst > 1.0e5 error hard    # |P| > ~10 GPa

dump            traj all custom 500000 quench_${tag}_${rate}.dump.seg3                 id type x y z vx vy vz
dump            traj all custom 500000 quench_N65536_${rate}.dump.seg3                 id type x y z vx vy vz
dump            traj all custom 500000 quench_N65536_2e10.dump.seg3                 id type x y z vx vy vz
dump_modify     traj sort id first yes
dump_modify     traj format float %.8g

print           "### tramo 3/16 (2e10 K/s) :  1700 K -> 1600 K"
### tramo 3/16 (2e10 K/s) :  1700 K -> 1600 K
fix              qnpt all npt temp 1700.0 1600.0 0.1 iso 0.0 0.0 ${pdamp}
fix              qnpt all npt temp 1700.0 1600.0 0.1 iso 0.0 0.0 10.0
run              5000000                        # 5 ns
