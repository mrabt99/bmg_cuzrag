LAMMPS (23 Jun 2022)
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread. (src/src/comm.cpp:98)
  using 1 OpenMP thread(s) per MPI task
# =====================================================================
#  ETAPA 2 (tramo 1/17) - Templado a 1e10 K/s : 2000 K -> 1900 K
#  Zr47.5 Cu47.5 Ag5 BMG - N65536 - Negishi/SLURM - v4 (NPT, Pdamp=10)
#
#  Generado a partir de in.quench_1e10 (version monolitica) para poder
#  encadenar jobs de SLURM con --dependency=afterok: a 1e10 K/s cada
#  tramo de 1e7 pasos (10 ns) tarda ~35 h a la performance medida en el
#  log del profesor (6.845 ns/dia, 48 MPI ranks; en la practica salio
#  ~4x mas rapido en Negishi, ~27 ns/dia medidos en la validacion) y el
#  walltime maximo de la cola no alcanza para los 17 tramos + el relax
#  en un solo job.
#
#  Ver ESTADO_PROYECTO_meltquench_1e10.md: v1 exploto a 1.67 ns con
#  Pdamp=1.0 (mismo valor que a 1e12 K/s). Aca Pdamp=10.0 (v4) + fix
#  halt como cinturon de seguridad real.
#
#  DOS CAMBIOS RESPECTO A LA PRIMERA VALIDACION (job 42846192, que
#  exploto en el paso 1710600, ~0.71 ns de rampa):
#   1) Semilla de velocidades: en vez de heredar las velocidades
#      exactas de restart.melt_${tag} (esa trayectoria exploto), se
#      re-generan a 2000 K con la MISMA semilla que en la segunda
#      validacion (job 42847448, "seed2"), que corrio los mismos 4.5 ns
#      completos sin problema.
#   2) Equilibracion extra a 2000 K constante (sugerencia de
#      Jaroszewicz): 2 ns (2e6 pasos) de NPT a T=2000K fijo ANTES de
#      empezar la rampa de enfriamiento, con su propio restart de
#      resguardo. Motivo probable (no confirmado con el profesor): el
#      barostato de Nose-Hoover tiene una variable extendida propia que
#      puede seguir oscilando/no asentada al salir de la fusion: si la
#      rampa de T arranca mientras esa oscilacion todavia no decayo,
#      un enfriamiento superpuesto podria amplificarla justo cuando
#      aparece un pico de fuerza EAM puntual. Mas tiempo a T constante
#      le da chance de asentarse antes de que el enfriamiento entre en
#      juego. 2 ns = ~20x el tiempo de relajacion nominal del barostato
#      (Pdamp=10 ps); ajustar si Jaroszewicz da un numero mas preciso.
#
#  Entrada:  restart.melt_${tag}  (velocidades re-generadas, ver abajo)
#  Salida:   restart.equil2000K_${tag}_${rate}      (checkpoint post-equilibracion)
#            restart.quench_${tag}_${rate}.seg1     (checkpoint post-rampa)
#            quench_${tag}_${rate}.dump.seg1   (11 frames: equilibracion + 10 de la rampa)
#            quench_${tag}_${rate}.log.dat.seg1 (T, Ep/atomo, Lx, rho, P)
# =====================================================================

variable        tag   index N65536
variable        pot   index ZrCuAg.lammps.eam
variable        rate  index 1e10
variable        pdamp index 10.0          # ps -- v4 fix (era 1.0 en 1e12)

read_restart    restart.melt_${tag}
read_restart    restart.melt_N65536
Reading restart file ...
  restart file = 12 Dec 2018, LAMMPS = 23 Jun 2022
WARNING: Old restart file format revision. Switching to compatibility mode. (src/src/read_restart.cpp:609)
  restoring atom style atomic from restart
  orthogonal box = (3.4161453 3.4161453 3.4161453) to (111.66491 111.66491 111.66491)
  3 by 4 by 4 MPI processor grid
  pair style eam/alloy stores no restart info
  65536 atoms
  read_restart CPU = 0.018 seconds

# Semilla "buena" (job 42847448, seed2): re-generar velocidades a
# 2000 K en vez de heredar las de restart.melt_${tag}, que llevaron a
# la explosion de la primera validacion.
velocity        all create 2000.0 918273645 mom yes rot yes dist gaussian

pair_style      eam/alloy
pair_coeff      * * ${pot} Zr Cu Ag
pair_coeff      * * ZrCuAg.lammps.eam Zr Cu Ag

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

timestep        0.001                       # 1 fs -- fijo, no tocar (VDOS/fonones)

thermo          10000
thermo_style    custom step temp press vol density pe etotal

variable        Tinst equal temp
variable        Pinst equal press
variable        PEat  equal pe/atoms
variable        Lbox  equal lx
variable        Rho   equal density

fix             log2 all ave/time 100 100 10000                 v_Tinst v_PEat v_Lbox v_Rho v_Pinst                 file quench_${tag}_${rate}.log.dat.seg1                 title2 "# T(K)  Ep(eV/at)  Lx(A)  rho(g/cc)  P(bar)"
fix             log2 all ave/time 100 100 10000                 v_Tinst v_PEat v_Lbox v_Rho v_Pinst                 file quench_N65536_${rate}.log.dat.seg1                 title2 "# T(K)  Ep(eV/at)  Lx(A)  rho(g/cc)  P(bar)"
fix             log2 all ave/time 100 100 10000                 v_Tinst v_PEat v_Lbox v_Rho v_Pinst                 file quench_N65536_1e10.log.dat.seg1                 title2 "# T(K)  Ep(eV/at)  Lx(A)  rho(g/cc)  P(bar)"

fix             halt_T all halt 100 v_Tinst > 8000.0 error hard
fix             halt_P all halt 100 v_Pinst > 1.0e5 error hard    # |P| > ~10 GPa

dump            traj all custom 1000000 quench_${tag}_${rate}.dump.seg1                 id type x y z vx vy vz
dump            traj all custom 1000000 quench_N65536_${rate}.dump.seg1                 id type x y z vx vy vz
dump            traj all custom 1000000 quench_N65536_1e10.dump.seg1                 id type x y z vx vy vz
dump_modify     traj sort id first yes
dump_modify     traj format float %.8g

print           "### equilibracion extra a 2000 K (2 ns) antes de la rampa -- sugerencia Jaroszewicz"
### equilibracion extra a 2000 K (2 ns) antes de la rampa -- sugerencia Jaroszewicz
fix              equil2000 all npt temp 2000.0 2000.0 0.1 iso 0.0 0.0 ${pdamp}
fix              equil2000 all npt temp 2000.0 2000.0 0.1 iso 0.0 0.0 10.0
run              2000000                        # 2 ns
