# =====================================================================
#  SEGMENTO 1 GLOBAL (2000 K -> 1900 K) -- REGENERADO CON DUMP
#  Zr47.5 Cu47.5 Ag5 BMG - N65536 - potencial EAM ORIGINAL (sin tocar)
#  NPT Pdamp=10.0, Tdamp=0.1, dt=1 fs (v4), 2e10 K/s
#
#  MOTIVO: in.ramp.lmp (el sweep original) no guardo dump de
#  trayectoria para este segmento -- solo thermo + restart final. La
#  auditoria del 11/09 marco eso como un hueco real (no se puede hacer
#  BOO/RDF/Voronoi con velocidades DENTRO del segmento 1, solo con el
#  restart final a 1900K). Este script repite EXACTAMENTE la misma
#  fisica desde el mismo restart de partida (mismas posiciones,
#  velocidades y caja -- no se re-samplea nada), agregando el dump que
#  faltaba, para llenar ese hueco sin cambiar el resultado fisico.
#
#  Determinismo esperado: mismo restart de entrada, mismo potencial,
#  mismo Pdamp/Tdamp/dt, sin ningun `velocity create` -- la trayectoria
#  deberia ser identica (o practicamente identica, modulo orden de
#  suma en punto flotante si cambia el numero de ranks) a la que ya
#  corrio en in.ramp.lmp. Se corre con los mismos 16 tasks que el
#  original para minimizar esa diferencia, y se verifica el estado
#  final (T~1900K) contra sweep_2e10.log.dat antes de dar esto por
#  bueno.
#
#  Escribe con nombres DISTINTOS a los del sweep original (no pisa
#  restart.sweep_2e10_1900K ni sweep_2e10.log.dat, que ya los usa
#  prod_2e10/in.quench_2e10_seg01.lmp rio abajo).
#
#  Punto de partida: ../restart.equil2000K_N65536_1e10 (2000 K,
#  semilla seed2 + 2ns de hold NPT, identico al sweep original).
# =====================================================================

variable        tag    index N65536
variable        pot    index ../ZrCuAg.lammps.eam
variable        rate   index 2e10
variable        pdamp  index 10.0

read_restart    ../restart.equil2000K_${tag}_1e10

pair_style      eam/alloy
pair_coeff      * * ${pot} Zr Cu Ag

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

timestep        0.001                       # 1 fs

thermo          5000
thermo_style    custom step temp press vol density pe etotal

variable        Tinst equal temp
variable        Pinst equal press
variable        PEat  equal pe/atoms
variable        Lbox  equal lx
variable        Rho   equal density

fix             log2 all ave/time 50 100 5000 &
                v_Tinst v_PEat v_Lbox v_Rho v_Pinst &
                file sweep_${rate}_redump.log.dat &
                title2 "# T(K)  Ep(eV/at)  Lx(A)  rho(g/cc)  P(bar)"

fix             halt_T all halt 1000 v_Tinst > 8000.0 error hard
fix             halt_P all halt 1000 v_Pinst > 1.0e5 error hard    # |P| > ~10 GPa

dump            traj all custom 500000 quench_${tag}_${rate}.dump.seg1_global &
                id type x y z vx vy vz
dump_modify     traj sort id first yes
dump_modify     traj format float %.8g

print           "### SEGMENTO 1 GLOBAL (redump) ${rate} K/s : 2000 K -> 1900 K en 5000000 pasos"
fix             qnpt all npt temp 2000.0 1900.0 0.1 iso 0.0 0.0 ${pdamp}
run             5000000
unfix           qnpt

print           "### SEGMENTO 1 (redump) OK (llego a 1900 K sin halt) : T=${Tinst} K  P=${Pinst} bar  Ep=${PEat} eV  Lx=${Lbox} A  rho=${Rho} g/cc"

write_restart   restart.sweep_${rate}_1900K_redump
