LAMMPS (23 Jun 2022)
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread. (src/src/comm.cpp:98)
  using 1 OpenMP thread(s) per MPI task
# =====================================================================
#  SWEEP DE TASA -- tramo unico 2000 K -> 1900 K a 1e10 K/s
#  Zr47.5 Cu47.5 Ag5 BMG - N65536 - potencial EAM ORIGINAL (sin tocar)
#  NPT Pdamp=10.0, Tdamp=0.1, dt=1 fs (v4)
#
#  OBJETIVO: medir empiricamente la tasa mas lenta que este tramo (el
#  mas caliente, el mas peligroso) tolera sin explotar. El runaway
#  estocastico viene de un defecto conocido del core repulsivo del
#  potencial por debajo de ~1.2 A -- NO se toca el potencial, se barre
#  la tasa para ver hasta donde aguanta.
#
#  Punto de partida IDENTICO para las 7 corridas del sweep:
#  ../restart.equil2000K_N65536_1e10 (2000 K, semilla seed2 -- la
#  misma que corrio limpio 4.5 ns en la validacion 2, job 42847448 --
#  + 2 ns de relajacion NPT a 2000 K constante, verificada estable
#  paso a paso). Unica variable entre las 7 corridas: la tasa
#  (= cuantos pasos se usan para bajar los mismos 100 K).
#
#  Tasa: 1e10 K/s -> 10000000 pasos para 2000->1900 K
# =====================================================================

variable        tag    index N65536
variable        pot    index ../ZrCuAg.lammps.eam
variable        rate   index 1e10
variable        pdamp  index 10.0

read_restart    ../restart.equil2000K_${tag}_1e10
read_restart    ../restart.equil2000K_N65536_1e10
Reading restart file ...
  restart file = 23 Jun 2022, LAMMPS = 23 Jun 2022
  restoring atom style atomic from restart
  orthogonal box = (3.4168601 3.4168601 3.4168601) to (111.66419 111.66419 111.66419)
  3 by 4 by 4 MPI processor grid
  pair style eam/alloy stores no restart info
  65536 atoms
  read_restart CPU = 0.020 seconds

pair_style      eam/alloy
pair_coeff      * * ${pot} Zr Cu Ag
pair_coeff      * * ../ZrCuAg.lammps.eam Zr Cu Ag

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

timestep        0.001                       # 1 fs

thermo          10000
thermo_style    custom step temp press vol density pe etotal

variable        Tinst equal temp
variable        Pinst equal press
variable        PEat  equal pe/atoms
variable        Lbox  equal lx
variable        Rho   equal density

fix             log2 all ave/time 100 100 10000                 v_Tinst v_PEat v_Lbox v_Rho v_Pinst                 file sweep_${rate}.log.dat                 title2 "# T(K)  Ep(eV/at)  Lx(A)  rho(g/cc)  P(bar)"
fix             log2 all ave/time 100 100 10000                 v_Tinst v_PEat v_Lbox v_Rho v_Pinst                 file sweep_1e10.log.dat                 title2 "# T(K)  Ep(eV/at)  Lx(A)  rho(g/cc)  P(bar)"

fix             halt_T all halt 1000 v_Tinst > 8000.0 error hard

print           "### SWEEP ${rate} K/s : 2000 K -> 1900 K en 10000000 pasos"
### SWEEP 1e10 K/s : 2000 K -> 1900 K en 10000000 pasos
fix             qnpt all npt temp 2000.0 1900.0 0.1 iso 0.0 0.0 ${pdamp}
fix             qnpt all npt temp 2000.0 1900.0 0.1 iso 0.0 0.0 10.0
run             10000000
