# =====================================================================
#  ETAPA 3 - Relajacion final 300 K, 0 Pa, 10 ns
#  Zr47.5 Cu47.5 Ag5 BMG - N65536 - Negishi/SLURM - v4 (NPT, Pdamp=10)
#
#  Arranca DIRECTO desde restart.quench_${tag}_${rate}.seg17 (final del
#  templado, 300 K ya alcanzados). Se corre aparte del templado, igual
#  que en la version 1e12 del profesor, porque agregar esta etapa al
#  final de la misma corrida sin salir de LAMMPS dispara
#  "ERROR: Invalid timestep reset for fix ave/time" (el fix log2 del
#  templado sigue activo). Al ser un proceso nuevo de LAMMPS no hay
#  fix log2 previo, asi que reset_timestep no da problema aca.
#
#  Pdamp=10.0 (igual que en el templado, v4) por consistencia; a T
#  constante el riesgo de runaway es mucho menor que durante la rampa,
#  pero no hay motivo para volver a Pdamp=1.0 en ninguna etapa de esta
#  corrida.
#
#  Entrada:  restart.quench_${tag}_${rate}.seg17
#  Salida:   relax300K_${tag}_${rate}.dump
#            restart.glass300K_${tag}_${rate}
#            data.glass300K_${tag}_${rate}
#            glass300K_${tag}_${rate}.dump
# =====================================================================

variable        tag   index N65536
variable        pot   index ZrCuAg.lammps.eam
variable        rate  index 1e10
variable        pdamp index 10.0

read_restart    restart.quench_${tag}_${rate}.seg17

pair_style      eam/alloy
pair_coeff      * * ${pot} Zr Cu Ag

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

timestep        0.001

thermo          10000
thermo_style    custom step temp press vol density pe etotal

variable        Tinst equal temp
variable        Pinst equal press
variable        PEat  equal pe/atoms
variable        Lbox  equal lx
variable        Rho   equal density

fix             log2 all ave/time 100 100 10000 &
                v_Tinst v_PEat v_Lbox v_Rho v_Pinst &
                file relax300K_${tag}_${rate}.log.dat &
                title2 "# T(K)  Ep(eV/at)  Lx(A)  rho(g/cc)  P(bar)"

fix             halt_T all halt 100 v_Tinst > 8000.0 error hard
fix             halt_P all halt 100 v_Pinst > 1.0e5 error hard

dump            relaxtraj all custom 1000000 relax300K_${tag}_${rate}.dump &
                id type x y z vx vy vz
dump_modify     relaxtraj sort id first yes

reset_timestep  0
fix             relax all npt temp 300.0 300.0 0.1 iso 0.0 0.0 ${pdamp}
run             10000000                     # 10 ns
unfix           relax

# NOTA (LAMMPS 20220623): estos prints tienen que ir ANTES de
# write_restart/write_data/write_dump o el compute temp/press queda
# "not current" y tira ERROR (verificado con test de sintaxis).
print           "### VIDRIO LISTO  (${tag}, ${rate} K/s, Pdamp=${pdamp} ps)"
print           "###   T        = ${Tinst} K"
print           "###   PE/atomo = ${PEat} eV     <-- comparar entre tamanos y tasas"
print           "###   Lx       = ${Lbox} A"
print           "###   densidad = ${Rho} g/cc    <-- comparar entre tamanos y tasas"

write_restart   restart.glass300K_${tag}_${rate}
write_data      data.glass300K_${tag}_${rate}
write_dump      all custom glass300K_${tag}_${rate}.dump id type x y z vx vy vz &
                modify sort id
