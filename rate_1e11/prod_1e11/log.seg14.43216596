LAMMPS (23 Jun 2022)
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread. (src/src/comm.cpp:98)
  using 1 OpenMP thread(s) per MPI task
# =====================================================================
#  Produccion 1e11 K/s (tramo 14/16) : 600 K -> 500 K
#  Zr47.5 Cu47.5 Ag5 BMG - N65536 - Negishi/SLURM - v4 (NPT, Pdamp=10)
#
#  Segunda tasa de la comparacion tipo Ryltsev (la primera, 2e10 K/s,
#  vive en 65536_1e10/). Mismo potencial EAM original sin tocar, mismo
#  ensemble/parametros (NPT Pdamp=10.0/Tdamp=0.1, dt=1fs fijo).
#
#  Esta cadena de 16 tramos arranca (tramo 1) desde
#  ../sweep_1e11/restart.sweep_1e11_1900K (el unico tramo de barrido a
#  esta tasa, 2000->1900K en 1ns, sobrevivio entero sin disparar fix
#  halt -- ver README.md). Este tramo en particular continua desde el
#  restart del tramo anterior de esta misma cadena (ver read_restart
#  mas abajo).
#  Aritmetica: 100 K / 1e11 K/s = 1e-9 s = 1 ns = 1000000 pasos por
#  tramo de 100 K. Quedan 16 tramos de 1900 a 300 K.
#
#  Entrada:  restart.quench_${tag}_${rate}.seg13
#  Salida:   restart.quench_${tag}_${rate}.seg14
#            quench_${tag}_${rate}.dump.seg14    (10 frames, cada 10K = cada 1e5 pasos)
#            quench_${tag}_${rate}.log.dat.seg14 (T, Ep/atomo, Lx, rho, P)
# =====================================================================

variable        tag   index N65536
variable        pot   index ../ZrCuAg.lammps.eam
variable        rate  index 1e11
variable        pdamp index 10.0

read_restart    restart.quench_${tag}_${rate}.seg13
read_restart    restart.quench_N65536_${rate}.seg13
read_restart    restart.quench_N65536_1e11.seg13
Reading restart file ...
  restart file = 23 Jun 2022, LAMMPS = 23 Jun 2022
  restoring atom style atomic from restart
  orthogonal box = (4.940092 4.940092 4.940092) to (110.14096 110.14096 110.14096)
  3 by 4 by 4 MPI processor grid
  pair style eam/alloy stores no restart info
  65536 atoms
  read_restart CPU = 0.526 seconds

pair_style      eam/alloy
pair_coeff      * * ${pot} Zr Cu Ag
pair_coeff      * * ../ZrCuAg.lammps.eam Zr Cu Ag

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

timestep        0.001                       # 1 fs -- fijo, no tocar (VDOS/fonones)

thermo          1000
thermo_style    custom step temp press vol density pe etotal

variable        Tinst equal temp
variable        Pinst equal press
variable        PEat  equal pe/atoms
variable        Lbox  equal lx
variable        Rho   equal density

fix             log2 all ave/time 10 100 1000                 v_Tinst v_PEat v_Lbox v_Rho v_Pinst                 file quench_${tag}_${rate}.log.dat.seg14                 title2 "# T(K)  Ep(eV/at)  Lx(A)  rho(g/cc)  P(bar)"
fix             log2 all ave/time 10 100 1000                 v_Tinst v_PEat v_Lbox v_Rho v_Pinst                 file quench_N65536_${rate}.log.dat.seg14                 title2 "# T(K)  Ep(eV/at)  Lx(A)  rho(g/cc)  P(bar)"
fix             log2 all ave/time 10 100 1000                 v_Tinst v_PEat v_Lbox v_Rho v_Pinst                 file quench_N65536_1e11.log.dat.seg14                 title2 "# T(K)  Ep(eV/at)  Lx(A)  rho(g/cc)  P(bar)"

fix             halt_T all halt 1000 v_Tinst > 8000.0 error hard
fix             halt_P all halt 1000 v_Pinst > 1.0e5 error hard    # |P| > ~10 GPa

dump            traj all custom 100000 quench_${tag}_${rate}.dump.seg14                 id type x y z vx vy vz
dump            traj all custom 100000 quench_N65536_${rate}.dump.seg14                 id type x y z vx vy vz
dump            traj all custom 100000 quench_N65536_1e11.dump.seg14                 id type x y z vx vy vz
dump_modify     traj sort id first yes
dump_modify     traj format float %.8g

print           "### tramo 14/16 (1e11 K/s) :  600 K -> 500 K"
### tramo 14/16 (1e11 K/s) :  600 K -> 500 K
fix              qnpt all npt temp 600.0 500.0 0.1 iso 0.0 0.0 ${pdamp}
fix              qnpt all npt temp 600.0 500.0 0.1 iso 0.0 0.0 10.0
run              1000000                        # 1 ns
