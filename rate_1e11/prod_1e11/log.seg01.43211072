# =====================================================================
#  Produccion 1e11 K/s (tramo 1/16) : 1900 K -> 1800 K
#  Zr47.5 Cu47.5 Ag5 BMG - N65536 - Negishi/SLURM - v4 (NPT, Pdamp=10)
#
#  Segunda tasa de la comparacion tipo Ryltsev (la primera, 2e10 K/s,
#  vive en 65536_1e10/). Mismo potencial EAM original sin tocar, mismo
#  ensemble/parametros (NPT Pdamp=10.0/Tdamp=0.1, dt=1fs fijo).
#
#  Punto de partida del tramo 1: ../sweep_1e11/restart.sweep_1e11_1900K
#  (el unico tramo de barrido a esta tasa, 2000->1900K en 1ns, sobrevivio
#  entero sin disparar fix halt -- ver 65536_1e10/README.md para la tabla
#  completa del barrido de tasas).
#
#  Ese restart NO es un numero de semilla -- es el estado de fase
#  completo (posiciones + velocidades de los 65536 atomos + caja) al
#  final del tramo de barrido real. No hay ningun `velocity create` aca:
#  este tramo resume la MISMA trayectoria fisica, no resiembra nada.
#  Identico patron a como prod_2e10/seg01 continuo (sin reseed) desde
#  restart.sweep_2e10_1900K en el proyecto anterior. Un reseed de
#  velocidades solo se agregaria reactivamente, tramo por tramo, si
#  algun segmento de esta cadena explota (igual que 2e10/seg02).
#
#  Aritmetica: 100 K / 1e11 K/s = 1e-9 s = 1 ns = 1000000 pasos por
#  tramo de 100 K. Quedan 16 tramos de 1900 a 300 K.
#
#  Entrada:  ../sweep_1e11/restart.sweep_1e11_1900K
#  Salida:   restart.quench_${tag}_${rate}.seg1
#            quench_${tag}_${rate}.dump.seg1    (10 frames, cada 10K = cada 1e5 pasos)
#            quench_${tag}_${rate}.log.dat.seg1 (T, Ep/atomo, Lx, rho, P)
# =====================================================================

variable        tag   index N65536
variable        pot   index ../ZrCuAg.lammps.eam
variable        rate  index 1e11
variable        pdamp index 10.0

read_restart    ../sweep_1e11/restart.sweep_1e11_1900K
Reading restart file ...
  restart file = 23 Jun 2022, LAMMPS = 23 Jun 2022
WARNING: Restart file used different # of processors: 16 vs. 48 (src/src/read_restart.cpp:654)
  restoring atom style atomic from restart
  orthogonal box = (3.518455 3.518455 3.518455) to (111.5626 111.5626 111.5626)
  3 by 4 by 4 MPI processor grid
  pair style eam/alloy stores no restart info
  65536 atoms
  read_restart CPU = 0.068 seconds

pair_style      eam/alloy
pair_coeff      * * ${pot} Zr Cu Ag
pair_coeff      * * ../ZrCuAg.lammps.eam Zr Cu Ag

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

timestep        0.001                       # 1 fs -- fijo, no tocar (VDOS/fonones)

thermo          1000
thermo_style    custom step temp press vol density pe etotal

variable        Tinst equal temp
variable        Pinst equal press
variable        PEat  equal pe/atoms
variable        Lbox  equal lx
variable        Rho   equal density

fix             log2 all ave/time 10 100 1000                 v_Tinst v_PEat v_Lbox v_Rho v_Pinst                 file quench_${tag}_${rate}.log.dat.seg1                 title2 "# T(K)  Ep(eV/at)  Lx(A)  rho(g/cc)  P(bar)"
fix             log2 all ave/time 10 100 1000                 v_Tinst v_PEat v_Lbox v_Rho v_Pinst                 file quench_N65536_${rate}.log.dat.seg1                 title2 "# T(K)  Ep(eV/at)  Lx(A)  rho(g/cc)  P(bar)"
fix             log2 all ave/time 10 100 1000                 v_Tinst v_PEat v_Lbox v_Rho v_Pinst                 file quench_N65536_1e11.log.dat.seg1                 title2 "# T(K)  Ep(eV/at)  Lx(A)  rho(g/cc)  P(bar)"

fix             halt_T all halt 1000 v_Tinst > 8000.0 error hard
fix             halt_P all halt 1000 v_Pinst > 1.0e5 error hard    # |P| > ~10 GPa

dump            traj all custom 100000 quench_${tag}_${rate}.dump.seg1                 id type x y z vx vy vz
dump            traj all custom 100000 quench_N65536_${rate}.dump.seg1                 id type x y z vx vy vz
dump            traj all custom 100000 quench_N65536_1e11.dump.seg1                 id type x y z vx vy vz
dump_modify     traj sort id first yes
dump_modify     traj format float %.8g

print           "### tramo 1/16 (1e11 K/s) :  1900 K -> 1800 K"
### tramo 1/16 (1e11 K/s) :  1900 K -> 1800 K
fix              qnpt all npt temp 1900.0 1800.0 0.1 iso 0.0 0.0 ${pdamp}
fix              qnpt all npt temp 1900.0 1800.0 0.1 iso 0.0 0.0 10.0
run              1000000                        # 1 ns
