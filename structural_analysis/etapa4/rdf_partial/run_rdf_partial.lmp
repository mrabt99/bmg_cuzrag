# =====================================================================
#  Etapa 4 / Tarea 3 - RDF por especie centrada (Cu y Zr) de UN restart, run 0.
#  Mismo r-grid que Tarea 1: 500 bins, 0..10 A (dr = 0.02 A).
#  compute rdf con 3 pares (itype jtype):
#    * *  -> total (all-all), igual que Tarea 1 (sanity check)
#    1 *  -> centrado en Zr (type 1), vecino cualquier especie
#    2 *  -> centrado en Cu (type 2), vecino cualquier especie
#  Salida (fix ave/time vector): index r g_total coord_total g_Zr coord_Zr g_Cu coord_Cu
#
#  Uso: lmp -in run_rdf_partial.lmp -var restart_file <p> -var pot_file <p> \
#           -var out_file <salida.txt>
# =====================================================================
variable restart_file index none
variable pot_file     index /scratch/negishi/aaabt/bmg_cuzrag/rate_2e10/ZrCuAg.lammps.eam
variable out_file     index rdf_partial.txt

units           metal
atom_style      atomic
read_restart    ${restart_file}

pair_style      eam/alloy
pair_coeff      * * ${pot_file} Zr Cu Ag

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes
comm_modify     cutoff 12.5   # rdf cutoff + skin (2.0) = 12.0

compute         rdf all rdf 500 * * 1 * 2 * cutoff 10.0
fix             rdf all ave/time 1 1 1 c_rdf[*] file ${out_file} mode vector

variable        rho equal atoms/vol
group           gZr type 1
group           gCu type 2
group           gAg type 3
thermo_style    custom step atoms temp lx ly lz vol v_rho
thermo          1
run             0
print "QC_BOX lx=$(lx:%.6f) ly=$(ly:%.6f) lz=$(lz:%.6f) natoms=$(atoms) numdens=$(v_rho:%.6f) nZr=$(count(gZr)) nCu=$(count(gCu)) nAg=$(count(gAg))"
