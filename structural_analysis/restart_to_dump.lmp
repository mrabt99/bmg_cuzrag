# =====================================================================
#  Etapa 0 - restart_to_dump: convierte UN restart de LAMMPS en un
#  dump de texto (custom: id type x y z, wrapped, sin velocidades),
#  legible por pyscal3.Trajectory y mdapy.System.
#
#  Zr47.5 Cu47.5 Ag5 BMG - N65536 - mismo potencial EAM sin tocar
#  usado en 65536_1e10 / 65536_1e11 / 65536_1e12.
#
#  Uso (variables via -var, todas overrideables desde la linea de
#  comandos; los defaults de abajo son el caso de prueba: un restart
#  de 2e10 K/s, la tasa completa mas simple de nombrar):
#
#    lmp -in restart_to_dump.lmp \
#        -var restart_file <path/al/restart> \
#        -var pot_file     <path/al/ZrCuAg.lammps.eam> \
#        -var out_file     <path/de/salida.dump>
# =====================================================================

units           metal
atom_style      atomic

variable        restart_file index /scratch/negishi/aaabt/bmg_cuzrag/rate_2e10/prod_2e10/restart.quench_N65536_2e10.seg8
variable        pot_file     index /scratch/negishi/aaabt/bmg_cuzrag/rate_2e10/ZrCuAg.lammps.eam
variable        out_file     index /scratch/negishi/aaabt/structural_analysis/test_snaps/08.dump

read_restart    ${restart_file}

pair_style      eam/alloy
pair_coeff      * * ${pot_file} Zr Cu Ag

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

# id type x y z (sin xu/yu/zu -> wrapped; sin vx vy vz -> mas liviano,
# no hace falta para analisis estructural)
write_dump      all custom ${out_file} id type x y z modify sort id
