# =====================================================================
#  Tarea E, validacion (Etapa 2, version final -- reemplaza el intento
#  anterior con `rerun` sobre snaps/*.dump). Mismo patron que
#  ~/legacy_scripts/boo_seba_ejemplo.in (real EAM, no pair_style zero;
#  read_restart + run 1, no rerun), extendido a los 4 nnn de Ryltsev
#  (12, 14, 15, 16) + wl/hat yes para tener Wl-hat ademas de Q4/Q6.
#
#  Un solo caso de validacion: 2e10, restart.quench_N65536_2e10.seg8
#  (mismo restart que boo_seba_ejemplo.in, para poder comparar
#  columna a columna). degrees 2 4 6 -> SOLO Q4 y Q6 (nnn_l=2), NO Q2
#  -- igual que el ejemplo del director.
#
#  Uso (todo via -var, sin defaults salvo el caso de validacion):
#    lmp -in validate_boo.lmp \
#        -var restart_file <path> -var pot_file <path> -var out_file <path>
# =====================================================================

variable restart_file index /scratch/negishi/aaabt/65536_1e10/prod_2e10/restart.quench_N65536_2e10.seg8
variable pot_file     index /scratch/negishi/aaabt/65536_1e10/ZrCuAg.lammps.eam
variable out_file     index /scratch/negishi/aaabt/structural_analysis/boo/validate_2e10_seg8.dump

units           metal
atom_style      atomic

read_restart    ${restart_file}
read_restart    /scratch/negishi/aaabt/65536_1e11/prod_1e11/restart.quench_N65536_1e11.seg11
Reading restart file ...
  restart file = 23 Jun 2022, LAMMPS = 23 Jun 2022
WARNING: Restart file used different # of processors: 48 vs. 16 (src/src/read_restart.cpp:654)
  restoring atom style atomic from restart
  orthogonal box = (4.746922 4.746922 4.746922) to (110.33413 110.33413 110.33413)
  2 by 2 by 4 MPI processor grid
  pair style eam/alloy stores no restart info
  65536 atoms
  read_restart CPU = 0.063 seconds

pair_style      eam/alloy
pair_coeff      * * ${pot_file} Zr Cu Ag
pair_coeff      * * /scratch/negishi/aaabt/65536_1e11/ZrCuAg.lammps.eam Zr Cu Ag

neighbor        2.0 bin
neigh_modify    delay 10 check yes

timestep        0.001
reset_timestep  0

# 4 computes, uno por nnn de Ryltsev; degrees 2 4 6 = solo l=4,l=6
# (2 columnas Q), + wl/hat yes agrega 2 columnas Wl-hat mas -> 4
# columnas por compute: Q4 Q6 W4hat W6hat
compute cQ12 all orientorder/atom nnn 12 degrees 2 4 6 wl/hat yes
compute cQ14 all orientorder/atom nnn 14 degrees 2 4 6 wl/hat yes
compute cQ15 all orientorder/atom nnn 15 degrees 2 4 6 wl/hat yes
compute cQ16 all orientorder/atom nnn 16 degrees 2 4 6 wl/hat yes

# columnas en el dump, en orden:
#   1=id 2=type
#   3=Q4_nnn12  4=Q6_nnn12  5=W4hat_nnn12  6=W6hat_nnn12
#   7=Q4_nnn14  8=Q6_nnn14  9=W4hat_nnn14 10=W6hat_nnn14
#  11=Q4_nnn15 12=Q6_nnn15 13=W4hat_nnn15 14=W6hat_nnn15
#  15=Q4_nnn16 16=Q6_nnn16 17=W4hat_nnn16 18=W6hat_nnn16
dump 1 all custom 10 ${out_file} id type     c_cQ12[*] c_cQ14[*] c_cQ15[*] c_cQ16[*]
dump 1 all custom 10 1e11/12.boo.dump id type     c_cQ12[*] c_cQ14[*] c_cQ15[*] c_cQ16[*]
dump_modify 1 sort id format float "%.6f"

run 1
