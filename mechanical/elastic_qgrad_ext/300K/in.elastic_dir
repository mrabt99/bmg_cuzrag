# UNA columna de Cij: componente de Voigt  dir = 1 xx, 2 yy, 3 zz, 4 yz, 5 xz, 6 xy   (se pasa con -var dir N). Hace los dos signos (-up y +up).
# (displace.mod del ejemplo, con el bucle de signos adentro). Para cada signo: restart.equil -> perturbacion -> NVT nequil -> NVT nrun promediando la presion.
# Cij = -(p_i(+up) - p_i(-up)) / (2 up) : diferencia central, la tension de referencia se cancela.
include init.mod
variable s index -1 1
label signloop
clear
box tilt large
read_restart restart.equil
include potential.mod
variable lx0 equal $(lx)
variable ly0 equal $(ly)
variable lz0 equal $(lz)
if "${dir} == 1" then "variable len0 equal ${lx0}"
if "${dir} == 2" then "variable len0 equal ${ly0}"
if "${dir} == 3" then "variable len0 equal ${lz0}"
if "${dir} == 4" then "variable len0 equal ${lz0}"
if "${dir} == 5" then "variable len0 equal ${lz0}"
if "${dir} == 6" then "variable len0 equal ${ly0}"
variable delta equal ${s}*${up}*${len0}
if "${dir} == 1" then "change_box all x delta 0 ${delta} remap units box"
if "${dir} == 2" then "change_box all y delta 0 ${delta} remap units box"
if "${dir} == 3" then "change_box all z delta 0 ${delta} remap units box"
if "${dir} == 4" then "change_box all yz delta ${delta} remap units box"
if "${dir} == 5" then "change_box all xz delta ${delta} remap units box"
if "${dir} == 6" then "change_box all xy delta ${delta} remap units box"
print "### dir ${dir} signo ${s}: delta = ${delta} A sobre len0 = ${len0} A (deformacion ingenieria ${s}*${up})"
fix therm all nvt temp ${temp} ${temp} ${tdamp}
run ${nequil}
fix avp all ave/time ${nevery} ${nreps} ${nser} c_thermo_press[1] c_thermo_press[2] c_thermo_press[3] c_thermo_press[4] c_thermo_press[5] c_thermo_press[6] ave running
fix ser all ave/time ${nevery} ${nreps} ${nser} c_thermo_press[1] c_thermo_press[2] c_thermo_press[3] c_thermo_press[4] c_thermo_press[5] c_thermo_press[6] file ser_dir${dir}_s${s}.dat
run ${nrun}
# guardar la presion media por componente de Voigt (n = signo negativo, p = positivo). Orden de c_thermo_press: pxx pyy pzz pxy pxz pyz
if "${s} < 0" then &
   "variable n1 equal $(f_avp[1])" "variable n2 equal $(f_avp[2])" "variable n3 equal $(f_avp[3])" &
   "variable n4 equal $(f_avp[6])" "variable n5 equal $(f_avp[5])" "variable n6 equal $(f_avp[4])" &
else &
   "variable p1 equal $(f_avp[1])" "variable p2 equal $(f_avp[2])" "variable p3 equal $(f_avp[3])" &
   "variable p4 equal $(f_avp[6])" "variable p5 equal $(f_avp[5])" "variable p6 equal $(f_avp[4])"
next s
jump SELF signloop

variable C1 equal -(v_p1-v_n1)/(2*${up})*${cfac}
variable C2 equal -(v_p2-v_n2)/(2*${up})*${cfac}
variable C3 equal -(v_p3-v_n3)/(2*${up})*${cfac}
variable C4 equal -(v_p4-v_n4)/(2*${up})*${cfac}
variable C5 equal -(v_p5-v_n5)/(2*${up})*${cfac}
variable C6 equal -(v_p6-v_n6)/(2*${up})*${cfac}
print "### COLUMNA ${dir} de Cij [${cunits}]: C1${dir} = $(v_C1:%.3f)  C2${dir} = $(v_C2:%.3f)  C3${dir} = $(v_C3:%.3f)  C4${dir} = $(v_C4:%.3f)  C5${dir} = $(v_C5:%.3f)  C6${dir} = $(v_C6:%.3f)" file Ccol${dir}.txt
