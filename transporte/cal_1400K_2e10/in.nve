# Paso 2 de 2: NVT corto + NVE de produccion. Guarda series para Green-Kubo y MSD.
# Uso: lmp -in in.nve -var rst cal_npt.restart -var vmean <A^3> -var T 1200 -var seed 1001 -var tag cal_r1
variable        rst    index  cal_npt.restart
variable        pot    index  ../../rate_2e10/ZrCuAg.lammps.eam
variable        T      index  1200.0
variable        vmean  index  0              # 0 = no reescalar caja
variable        seed   index  1001
variable        tag    index  cal_r1
variable        nnvt   index  20000          # 20 ps
variable        nprod  index  500000         # 0.5 ns
variable        sp     index  2              # muestreo del tensor de presion (pasos = fs)
variable        sj     index  5              # muestreo del flujo de calor

read_restart    ${rst}
pair_style      eam/alloy
pair_coeff      * * ${pot} Zr Cu Ag
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes
timestep        0.001

if "${vmean} > 0" then "variable s equal (${vmean}/vol)^(1.0/3.0)" "change_box all x scale ${s} y scale ${s} z scale ${s} remap"

group           Zr type 1
group           Cu type 2
group           Ag type 3

variable        Tinst equal temp
fix             halt_T all halt 1000 v_Tinst > 8000.0 error hard
# halts tempranos (patologia del EAM a alta T, ver size_8192/README.md): distancia minima y densidad
compute         pl all pair/local dist
compute         dmin all reduce min c_pl
variable        dmin equal c_dmin
variable        rho equal density
fix             halt_d all halt 1000 v_dmin < 1.5 error hard
fix             halt_r all halt 1000 v_rho < 6.0 error hard
thermo          1000
thermo_style    custom step temp press vol pe ke etotal

# replica: velocidades nuevas, termalizar en NVT
velocity        all create ${T} ${seed} mom yes rot yes dist gaussian
fix             nvt all nvt temp ${T} ${T} 0.1
run             ${nnvt}
unfix           nvt

# --- produccion NVE ---
reset_timestep  0
compute         pt all pressure thermo_temp
compute         ke all ke/atom
compute         pe all pe/atom
compute         st all stress/atom NULL virial
compute         hf all heat/flux ke pe st
compute         mZr Zr msd
compute         mCu Cu msd
compute         mAg Ag msd

# pt[1..6] = pxx pyy pzz pxy pxz pyz (bar)
fix             fp all ave/time ${sp} 1 ${sp} c_pt[1] c_pt[2] c_pt[3] c_pt[4] c_pt[5] c_pt[6] file ${tag}_press.dat
# hf[1..3] = Jx Jy Jz (eV*A/ps, SIN dividir por V)
fix             fj all ave/time ${sj} 1 ${sj} c_hf[1] c_hf[2] c_hf[3] file ${tag}_hflux.dat
fix             fm all ave/time 1000 1 1000 c_mZr[4] c_mCu[4] c_mAg[4] file ${tag}_msd.dat
variable        vv equal vol
variable        et equal etotal
fix             ft all ave/time 1000 1 1000 v_Tinst c_thermo_pe v_vv v_et file ${tag}_thermo.dat

fix             nve all nve
run             ${nprod}
