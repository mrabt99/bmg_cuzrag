# Mismo sistema en units metal: se analiza con LA MISMA conversion que nuestro pipeline (eV*A/ps -> SI).
variable    seed index 102486
variable    ens index nvt
variable    tag index ar_metal
variable    T equal 70
units       metal
dimension    3
boundary     p p p
lattice      fcc 5.376 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region       box block 0 4 0 4 0 4
create_box   1 box
create_atoms 1 box
mass         1 39.948
pair_style   lj/cut 13.0
pair_coeff   * * 0.010330 3.405
timestep     0.004
thermo       2000
velocity     all create $T ${seed} mom yes rot yes dist gaussian
fix          NVT all nvt temp $T $T 0.01 drag 0.2
run          8000
if "${ens} == nve" then "unfix NVT" "fix NVE all nve"
reset_timestep 0
compute      myKE all ke/atom
compute      myPE all pe/atom
compute      myStress all stress/atom NULL virial
compute      flux all heat/flux myKE myPE myStress
fix          Jraw all ave/time 10 1 10 c_flux[1] c_flux[2] c_flux[3] file ${tag}_Jraw.dat
variable     vv equal vol
thermo_style custom step temp pe v_vv
run          100000
variable     V equal vol
print        "V_A3 = ${V}"
