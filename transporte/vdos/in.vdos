# VDOS por especie a partir de la autocorrelación de velocidades (VACF), 2026-11-14.
# Misma configuración que cal_300K_2e10: restart NPT + reescalado a V medio + NVT 20 ps + NVE.
# En NVE: NORIG orígenes consecutivos de VACF, cada uno de LSEG pasos (4 ps).
# compute vacf promedia sobre todos los átomos del grupo con origen en el momento en que se define.
# Uso: lmp -in in.vdos -var rst ../cal_300K_2e10/cal_npt.restart -var vmean <A^3> -var T 300 -var tag v300_2e10
variable        rst    index  ../cal_300K_2e10/cal_npt.restart
variable        pot    index  ../../rate_2e10/ZrCuAg.lammps.eam
variable        T      index  300.0
variable        vmean  index  0              # 0 = no reescalar caja
variable        seed   index  4004
variable        tag    index  v300_2e10
variable        nnvt   index  20000          # 20 ps
variable        LSEG   index  4000           # 4 ps por origen
variable        NORIG  index  20             # 20 orígenes -> 80 ps de NVE
variable        sv     index  2              # muestreo de la VACF (pasos = fs)
variable        rep    index  1              # replicación de la caja (1 = sin replicar)

read_restart    ${rst}
pair_style      eam/alloy
pair_coeff      * * ${pot} Zr Cu Ag
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes
timestep        0.001

if "${vmean} > 0" then "variable s equal (${vmean}/vol)^(1.0/3.0)" "change_box all x scale ${s} y scale ${s} z scale ${s} remap"
# rep > 1: replica la caja rep x rep x rep (2026-11-15, para bajar el primer modo acústico de la caja).
# Las velocidades se recrean abajo, así que las copias no vibran en fase.
if "${rep} > 1" then "replicate ${rep} ${rep} ${rep}"

group           Zr type 1
group           Cu type 2
group           Ag type 3

variable        Tinst equal temp
fix             halt_T all halt 1000 v_Tinst > 8000.0 error hard
thermo          1000
thermo_style    custom step temp press vol pe ke etotal

velocity        all create ${T} ${seed} mom yes rot yes dist gaussian
fix             nvt all nvt temp ${T} ${T} 0.1
run             ${nnvt}
unfix           nvt

# --- producción NVE ---
reset_timestep  0
variable        et equal etotal
fix             ft all ave/time 100 1 100 v_Tinst c_thermo_pe v_et file ${tag}_thermo.dat
fix             nve all nve

variable        i loop ${NORIG}
label           orig
compute         vZr Zr vacf
compute         vCu Cu vacf
compute         vAg Ag vacf
# columnas: paso, <vx(0)vx(t)>... [1..3] y total [4], por especie (Å²/ps²)
fix             fv all ave/time ${sv} 1 ${sv} c_vZr[4] c_vCu[4] c_vAg[4] c_vZr[1] c_vZr[2] c_vZr[3] file ${tag}_vacf_${i}.dat
run             ${LSEG}
unfix           fv
uncompute       vZr
uncompute       vCu
uncompute       vAg
next            i
jump            SELF orig

print           "### VDOS listo: ${NORIG} orígenes de ${LSEG} pasos"
