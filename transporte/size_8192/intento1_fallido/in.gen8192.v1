# Prueba de tamano para kappa: sistema de 8192 atomos Zr47.5Cu47.5Ag5 (3891 Zr, 3891 Cu, 410 Ag).
# No tenemos el in.melt del profesor: se construye una red bcc 16x16x16 (8192 sitios) con tipos al azar,
# se funde y se aplica el protocolo de rate_1e12_reference/in.quench_1e12 (1e12 K/s, NPT iso, Tdamp 0.1, Pdamp 1.0).
# Escribe restart.T1000_N8192_1e12 (fin del tramo 1100->1000 K) y restart.quench_N8192_1e12.T300.
# Uso: lmp -in in.gen8192 [-var fac 1]   (fac<1 solo para probar la sintaxis)
variable        fac   index 1.0
variable        pot   index ../../rate_2e10/ZrCuAg.lammps.eam
units           metal
atom_style      atomic
boundary        p p p
lattice         bcc 3.33
region          box block 0 16 0 16 0 16
create_box      3 box
create_atoms    1 box
set             type 1 type/subset 2 3891 4711
set             type 1 type/subset 3 410 8123
mass            1 91.224
mass            2 63.546
mass            3 107.868
pair_style      eam/alloy
pair_coeff      * * ${pot} Zr Cu Ag
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes
timestep        0.001
group           Zr type 1
group           Cu type 2
group           Ag type 3
print           "### N(Zr,Cu,Ag) = $(count(Zr)) $(count(Cu)) $(count(Ag))"
variable        Tinst equal temp
fix             halt_T all halt 1000 v_Tinst > 8000.0 error hard
thermo          1000
thermo_style    custom step temp press vol density pe etotal
fix             log2 all ave/time 1 100 100 v_Tinst c_thermo_pe file gen8192.log.dat
# --- fundido: 2500 K 100 ps (desordenar la red), luego 2000 K 1 ns (como el paper) ---
velocity        all create 2500.0 24680 mom yes rot yes dist gaussian
fix             m all npt temp 2500.0 2500.0 0.1 iso 0.0 0.0 1.0
variable        n1 equal round(100000*${fac})
run             ${n1}
unfix           m
fix             m all npt temp 2000.0 2000.0 0.1 iso 0.0 0.0 1.0
variable        n2 equal round(1000000*${fac})
run             ${n2}
unfix           m
write_restart   restart.melt_N8192
# --- templado 2000 -> 300 K a 1e12 K/s: 17 tramos de 100 K x 100 ps ---
variable        nseg equal round(100000*${fac})
variable        i loop 17
label           lseg
variable        Ta equal 2000-100*(${i}-1)
variable        Tb equal 2000-100*${i}
fix             q all npt temp ${Ta} ${Tb} 0.1 iso 0.0 0.0 1.0
run             ${nseg}
unfix           q
if "${Tb} == 1000" then "write_restart restart.T1000_N8192_1e12"
next            i
jump            SELF lseg
write_restart   restart.quench_N8192_1e12.T300
print           "### GEN LISTO"
